// Prisma schema file for OrchestrAI Model Governance (OMG)
// Connected to PostgreSQL (Neon PostgreSQL / Local Docker)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  APPLICATION
  AGENT
  MODEL
  LLM
  COPILOT
  RAG_SYSTEM
  AI_WORKFLOW
  MULTI_AGENT_SYSTEM
  THIRD_PARTY_SERVICE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GovernanceStatus {
  DRAFT
  REVIEW
  VALIDATION
  APPROVAL
  PRODUCTION
  RETIREMENT
}

enum DecisionOutcome {
  GO
  CONDITIONAL_GO
  NO_GO
  PENDING
}

// ---------------------------------------------------------------------------
// RELEASE 1 — Governance Authority Foundation
// Accountability, human oversight and autonomy exposure, made explicit on
// every AI asset. Reference data only — no scoring, no workflow automation.
// ---------------------------------------------------------------------------

enum HumanOversightType {
  HUMAN_IN_COMMAND
  HUMAN_IN_THE_LOOP
  HUMAN_ON_THE_LOOP
  AUTONOMOUS_WITH_CONTROLS
}

// ---------------------------------------------------------------------------
// RELEASE 2 — Governance Continuity Foundation
// Whether an approved AI asset remains validly authorized over time.
// Visibility and lightweight workflow only — no scoring, no automation.
// ---------------------------------------------------------------------------

/// Release 1 recommendation, carried forward — business context, reused by
/// Governance Continuity and future Compliance Packs / RBI / ISO layers.
enum GovernanceClassification {
  INTERNAL_PRODUCTIVITY
  CUSTOMER_FACING
  DECISION_SUPPORT
  OPERATIONAL_AUTOMATION
  AGENTIC_WORKFLOW
  REGULATED_AI
}

/// Named AssetGovernanceState (not GovernanceState) to avoid colliding with
/// the Phase 10 change-management GovernanceState enum below, which tracks a
/// different concern (pipeline/state-machine position, not authorization validity).
enum AssetGovernanceState {
  DRAFT
  SUBMITTED
  AUTHORIZED
  MONITORING
  REASSESSMENT_REQUIRED
  CONDITIONAL_GO
  NO_GO
  RETIRED
}

enum ReassessmentTriggerType {
  MODEL_CHANGE
  PROMPT_CHANGE
  AGENT_BEHAVIOR_CHANGE
  NEW_INTEGRATION
  NEW_TOOL
  DATA_SOURCE_CHANGE
  PERMISSION_CHANGE
  ACCESS_SCOPE_CHANGE
  CONTROL_FAILURE
  RISK_THRESHOLD_BREACH
  PERFORMANCE_DRIFT
  REGULATORY_CHANGE
  POLICY_CHANGE
}

enum ReassessmentTriggerStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

// ---------------------------------------------------------------------------
// RELEASE 3 — Evidence Foundation
// Evidence as a first-class, universal governance object: registry,
// ownership, traceability, lifecycle and expiry. No scoring, no automation.
// ---------------------------------------------------------------------------

enum EvidenceRecordType {
  POLICY_DOCUMENT
  RISK_ASSESSMENT
  VALIDATION_REPORT
  APPROVAL_RECORD
  GOVERNANCE_REVIEW
  AUDIT_FINDING
  INCIDENT_REPORT
  CONTROL_ASSESSMENT
  TRAINING_RECORD
  THIRD_PARTY_ASSESSMENT
}

enum EvidenceRecordStatus {
  DRAFT
  ACTIVE
  EXPIRED
  ARCHIVED
  SUPERSEDED
}

enum UserRole {
  SUPER_ADMIN
  GOVERNANCE_ADMIN
  RISK_OFFICER
  BUSINESS_OWNER
  VALIDATOR
  AUDITOR
  VIEWER
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  role       UserRole @default(GOVERNANCE_ADMIN)
  department String
  status     String   @default("Active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  businessAssets   AssetOwner[] @relation("BusinessOwner")
  technicalAssets  AssetOwner[] @relation("TechnicalOwner")
  riskAssets       AssetOwner[] @relation("RiskOwner")
  complianceAssets AssetOwner[] @relation("ComplianceOwner")
  approvedAssets   AssetOwner[] @relation("Approver")
  auditLogs        AuditLog[]

  @@map("users")
}

model AIAsset {
  id                String           @id @default(uuid())
  name              String
  type              AssetType
  description       String           @db.Text
  department        String
  version           String           @default("1.0.0")
  status            GovernanceStatus @default(DRAFT)
  operationalStatus String           @default("Active")
  riskLevel         RiskLevel        @default(MEDIUM)
  techStack         String[]
  dataSensitivity   String           @default("Confidential")
  validationScore   Int?
  decisionOutcome   DecisionOutcome  @default(PENDING)
  tags              String[]

  // Release 1 — Governance Authority Profile (Capability 1)
  /// Ultimately accountable individual — distinct from AssetOwner.businessOwner.
  /// Q1 Stabilization: required — no asset may exist without named accountability.
  accountableOwner       String
  governanceSponsor      String
  humanOverrideAuthority String?
  killSwitchAuthority    String?
  reassessmentAuthority  String?
  /// Release 4 — completes the Authority Profile as flat, API-writable scalars
  /// (distinct from the legacy User-relation-based AssetOwner.riskOwner etc.).
  /// Q1 Stabilization: required — no asset may exist without named accountability.
  authorityRiskOwner       String
  authorityTechnicalOwner  String
  authorityComplianceOwner String?

  /// Release 4 — the free-text five-role Ownership Matrix (OwnershipAssignment),
  /// stored as JSON rather than forced through the User-relation AssetOwner
  /// model, since demo/API ownership today is names, not resolved User rows.
  ownershipJson Json?

  // Release 1 — Human Oversight Classification (Capability 2)
  oversightType HumanOversightType?

  // Release 1 — Autonomy Classification (Capability 3), Level 0-5
  autonomyLevel Int?

  // Release 1 recommendation / Release 2 — Governance Classification
  governanceClassification GovernanceClassification?

  // Release 2 — Governance State Model (Capability 1)
  governanceState AssetGovernanceState? @default(DRAFT)
  nextReviewDate  DateTime?

  // Q1 Stabilization — Soft Delete / Archive Model (Phase 3).
  // Deletion is no longer destructive: an "archived" asset keeps its row (and
  // therefore every cascaded evidence/finding/decision/incident record) intact.
  isArchived    Boolean   @default(false)
  archivedAt    DateTime?
  archivedBy    String?
  archiveReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owners                AssetOwner?
  decisions             DecisionRecord[]
  riskAssessments       RiskAssessment[]
  validations           ValidationRecord[]
  reassessmentTriggers  ReassessmentTrigger[]
  reauthorizations      GovernanceReauthorizationRecord[]
  evidenceRecords       EvidenceRecord[]
  evidence              EvidenceDocument[]
  findings              Finding[]
  complianceAssessments ComplianceAssessmentRecord[]
  killSwitches          KillSwitchRecord[]
  overrides             OverrideRecord[]
  incidents             GovernanceIncident[]
  retirements           RetirementRecord[]
  scheduledReviews      ScheduledReview[]
  correctiveActions     CorrectiveAction[]
  alerts                GovernanceAlert[]
  auditLogs             AuditLog[]
  policyViolations      PolicyViolation[]
  changeRequests        ChangeRequest[]
  stateTransitions      StateTransition[]
  governanceFindings    GovernanceFinding[]
  recommendedActions    RecommendedAction[]

  @@map("ai_assets")
}

model AssetOwner {
  id      String  @id @default(uuid())
  assetId String  @unique
  asset   AIAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  businessOwnerId String?
  businessOwner   User?   @relation("BusinessOwner", fields: [businessOwnerId], references: [id])

  technicalOwnerId String?
  technicalOwner   User?   @relation("TechnicalOwner", fields: [technicalOwnerId], references: [id])

  riskOwnerId String?
  riskOwner   User?   @relation("RiskOwner", fields: [riskOwnerId], references: [id])

  complianceOwnerId String?
  complianceOwner   User?   @relation("ComplianceOwner", fields: [complianceOwnerId], references: [id])

  approverId String?
  approver   User?   @relation("Approver", fields: [approverId], references: [id])

  @@map("asset_owners")
}

model RiskAssessment {
  id                String    @id @default(uuid())
  assetId           String
  asset             AIAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  overallRiskTier   RiskLevel
  context           String
  dataSensitivity   String
  decisionImpact    String
  operationalImpact String
  controlOversight  String
  assessedBy        String
  createdAt         DateTime  @default(now())

  @@map("risk_assessments")
}

model DecisionRecord {
  id            String          @id @default(uuid())
  assetId       String
  asset         AIAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  outcome       DecisionOutcome
  checklist     Json
  decisionOwner String
  justification String          @db.Text
  createdAt     DateTime        @default(now())

  @@map("decision_records")
}

model ValidationRecord {
  id              String   @id @default(uuid())
  assetId         String
  asset           AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  category        String
  reviewer        String
  reviewerRole    String
  reviewDate      DateTime @default(now())
  status          String
  score           Int
  findings        String   @db.Text
  recommendations String   @db.Text

  @@map("validation_records")
}

model EvidenceDocument {
  id              String   @id @default(uuid())
  title           String
  category        String
  deliverableType String
  assetId         String
  asset           AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedBy      String
  uploadDate      DateTime @default(now())
  version         String
  status          String
  description     String   @db.Text

  @@map("evidence_documents")
}

model Finding {
  id           String   @id @default(uuid())
  title        String
  assetId      String
  asset        AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  severity     String
  status       String
  assignedTo   String
  reportedBy   String
  reportedDate DateTime @default(now())
  description  String   @db.Text

  @@map("findings")
}

model ComplianceAssessmentRecord {
  id           String   @id @default(uuid())
  assetId      String
  asset        AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  controlId    String
  controlName  String
  status       String
  score        Int
  assessor     String
  assessedDate DateTime @default(now())
  notes        String   @db.Text

  @@map("compliance_assessments")
}

model KillSwitchRecord {
  id              String   @id @default(uuid())
  assetId         String
  asset           AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  triggerCategory String
  status          String
  requestedBy     String
  approvedBy      String
  activatedAt     DateTime @default(now())
  reason          String   @db.Text
  resolutionNotes String?  @db.Text

  @@map("kill_switches")
}

model OverrideRecord {
  id            String   @id @default(uuid())
  assetId       String
  asset         AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  triggerReason String   @db.Text
  requestedBy   String
  approvedBy    String
  timestamp     DateTime @default(now())
  actionTaken   String   @db.Text

  @@map("overrides")
}

model GovernanceIncident {
  id          String   @id @default(uuid())
  assetId     String
  asset       AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title       String
  type        String
  severity    String
  status      String
  reportedBy  String
  assignedTo  String
  createdAt   DateTime @default(now())
  description String   @db.Text

  @@map("incidents")
}

model RetirementRecord {
  id                    String   @id @default(uuid())
  assetId               String
  asset                 AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reason                String
  requestedBy           String
  approvedBy            String
  retiredAt             DateTime @default(now())
  evidenceArchivedCount Int      @default(0)
  notes                 String   @db.Text

  @@map("retirements")
}

model ScheduledReview {
  id         String   @id @default(uuid())
  assetId    String
  asset      AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reviewType String
  owner      String
  dueDate    DateTime
  status     String   @default("Scheduled")
  outcome    String?  @db.Text

  @@map("scheduled_reviews")
}

model CorrectiveAction {
  id                String   @id @default(uuid())
  assetId           String
  asset             AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title             String
  status            String   @default("Open")
  severity          String
  assignedTo        String
  dueDate           DateTime
  description       String   @db.Text
  verificationNotes String?  @db.Text

  @@map("corrective_actions")
}

model GovernanceAlert {
  id             String   @id @default(uuid())
  assetId        String
  asset          AIAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  alertType      String
  severity       String
  createdAt      DateTime @default(now())
  message        String   @db.Text
  resolutionPath String

  @@map("governance_alerts")
}

// ---------------------------------------------------------------------------
// PHASE 9 — Policy Governance
// OMG moves from governing assets to governing the rules that bind them.
// ---------------------------------------------------------------------------

enum PolicyCategory {
  GOVERNANCE
  RISK
  SECURITY
  PRIVACY
  VENDOR
}

enum PolicyStatus {
  ACTIVE
  DRAFT
  UNDER_REVIEW
  RETIRED
}

enum PolicyTargetType {
  AI_ASSET
  ASSET_TYPE
  VENDOR
  BUSINESS_UNIT
}

enum PolicyViolationStatus {
  OPEN
  UNDER_REVIEW
  ACCEPTED
  REMEDIATED
  CLOSED
}

model Policy {
  id              String         @id @default(uuid())
  policyRef       String         @unique
  name            String
  category        PolicyCategory @default(GOVERNANCE)
  owner           String
  ownerRole       String
  effectiveDate   DateTime
  reviewDate      DateTime
  status          PolicyStatus   @default(DRAFT)
  description     String         @db.Text
  mandatory       Boolean        @default(false)
  /// Enforcement rule key evaluated against live governance state.
  enforcementRule String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  mappings   PolicyMapping[]
  violations PolicyViolation[]

  @@map("policies")
}

model PolicyMapping {
  id         String           @id @default(uuid())
  policyId   String
  policy     Policy           @relation(fields: [policyId], references: [id], onDelete: Cascade)
  targetType PolicyTargetType
  /// Asset id, asset type, vendor key or business unit name depending on targetType.
  targetId   String
  targetName String
  mappedBy   String
  mappedDate DateTime         @default(now())
  notes      String?          @db.Text

  @@unique([policyId, targetType, targetId])
  @@map("policy_mappings")
}

model PolicyViolation {
  id               String                @id @default(uuid())
  policyId         String
  policy           Policy                @relation(fields: [policyId], references: [id], onDelete: Cascade)
  violationType    String
  assetId          String
  asset            AIAsset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  severity         String
  owner            String
  detectionDate    DateTime              @default(now())
  status           PolicyViolationStatus @default(OPEN)
  description      String                @db.Text
  remediationNotes String?               @db.Text
  /// True when raised by the enforcement engine rather than logged by a human.
  autoDetected     Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@map("policy_violations")
}

// ---------------------------------------------------------------------------
// PHASE 10 — Governance Change Management
// Approval is not permanent. Every significant change to an AI asset must be
// evaluated, governed and approved before it proceeds.
// ---------------------------------------------------------------------------

enum ChangeStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IMPLEMENTED
  CLOSED
}

enum ChangeCategory {
  MODEL
  VENDOR
  DATA
  PROMPT
  POLICY
  OPERATIONAL
}

enum ChangeMagnitude {
  MINOR
  MODERATE
  MAJOR
  CRITICAL
}

enum ReassessmentRequirement {
  NO_REASSESSMENT
  RISK_REVIEW_REQUIRED
  FULL_GOVERNANCE_REVIEW
  EXECUTIVE_APPROVAL_REQUIRED
}

enum ApproverRole {
  ASSET_OWNER
  REVIEWER
  GOVERNANCE_LEAD
  RISK_MANAGER
  COMPLIANCE_OFFICER
  EXECUTIVE_APPROVER
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum GovernanceState {
  DRAFT
  REVIEW
  APPROVED
  PRODUCTION
  MONITORING
  CHANGE_REQUESTED
  IMPACT_ASSESSMENT
  REASSESSMENT
  REAPPROVED
  RETIREMENT
}

model ChangeRequest {
  id                    String         @id @default(uuid())
  changeRef             String         @unique
  title                 String
  description           String         @db.Text
  assetId               String
  asset                 AIAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  requestedBy           String
  requestedByRole       String
  category              ChangeCategory
  businessJustification String         @db.Text
  requestedDate         DateTime       @default(now())
  status                ChangeStatus   @default(DRAFT)

  /// WS3 — impact outcome per governance impact area, keyed by area name.
  impact       Json?
  /// WS4 — weighted 0-100 impact score derived from the assessment.
  impactScore  Int?
  magnitude    ChangeMagnitude?
  reassessment ReassessmentRequirement?

  submittedDate     DateTime?
  decidedDate       DateTime?
  implementedDate   DateTime?
  closedDate        DateTime?
  decisionRationale String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals      ChangeApproval[]
  transitions    StateTransition[]
  historyEntries ChangeHistoryEntry[]

  @@map("change_requests")
}

model ChangeApproval {
  id        String           @id @default(uuid())
  changeId  String
  change    ChangeRequest    @relation(fields: [changeId], references: [id], onDelete: Cascade)
  role      ApproverRole
  approver  String
  decision  ApprovalDecision @default(PENDING)
  decidedAt DateTime?
  notes     String?          @db.Text

  @@unique([changeId, role])
  @@map("change_approvals")
}

model StateTransition {
  id        String          @id @default(uuid())
  assetId   String
  asset     AIAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromState GovernanceState
  toState   GovernanceState
  changeId  String?
  change    ChangeRequest?  @relation(fields: [changeId], references: [id], onDelete: SetNull)
  actor     String
  reason    String          @db.Text
  timestamp DateTime        @default(now())

  @@map("state_transitions")
}

model ChangeHistoryEntry {
  id         String        @id @default(uuid())
  changeId   String
  change     ChangeRequest @relation(fields: [changeId], references: [id], onDelete: Cascade)
  assetId    String
  /// What changed.
  action     String
  /// Who changed it.
  actor      String
  actorRole  String
  /// Why it changed.
  rationale  String        @db.Text
  /// Who approved it, where applicable.
  approvedBy String?
  fromStatus ChangeStatus?
  toStatus   ChangeStatus?
  timestamp  DateTime      @default(now())

  @@map("change_history")
}

model GovernanceTriggerRule {
  id          String           @id @default(uuid())
  condition   String
  action      String
  description String           @db.Text
  /// Change categories that arm this rule.
  categories  ChangeCategory[]
  enabled     Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("governance_trigger_rules")
}

// ---------------------------------------------------------------------------
// RELEASE 2 — Governance Continuity Foundation, continued
// ---------------------------------------------------------------------------

/// Capability 3 — Reassessment Trigger Framework. A manually logged event
/// register, not a rule engine (see PolicyViolation / GovernanceTriggerRule
/// for the Phase 10 automated equivalent, which Release 2 does not replace).
model ReassessmentTrigger {
  id           String                    @id @default(uuid())
  assetId      String
  asset        AIAsset                   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  triggerType  ReassessmentTriggerType
  dateDetected DateTime                  @default(now())
  severity     RiskLevel
  owner        String
  status       ReassessmentTriggerStatus @default(OPEN)
  comments     String                    @db.Text
  createdAt    DateTime                  @default(now())

  @@map("reassessment_triggers")
}

/// Capability 5 — Governance Reauthorization Record. Traces every decision
/// that moves an asset's Governance State forward again after reassessment.
model GovernanceReauthorizationRecord {
  id              String               @id @default(uuid())
  assetId         String
  asset           AIAsset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reviewedBy      String
  reviewDate      DateTime             @default(now())
  decision        DecisionOutcome
  reason          String               @db.Text
  supportingNotes String?              @db.Text
  previousState   AssetGovernanceState
  newState        AssetGovernanceState
  createdAt       DateTime             @default(now())

  @@map("governance_reauthorization_records")
}

// ---------------------------------------------------------------------------
// RELEASE 3 — Evidence Foundation, continued
// ---------------------------------------------------------------------------

/// Capability 1 — Evidence Registry. The universal governance evidence
/// object, distinct from the earlier ODF-deliverable EvidenceDocument model.
model EvidenceRecord {
  id           String               @id @default(uuid())
  name         String
  evidenceType EvidenceRecordType
  status       EvidenceRecordStatus @default(DRAFT)
  createdDate  DateTime             @default(now())
  expiryDate   DateTime?
  description  String               @db.Text

  assetId String
  asset   AIAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Capability 3 — Evidence Ownership
  evidenceOwner     String
  businessOwner     String?
  reviewer          String?
  approvalAuthority String?

  /// Capability 4 — Evidence Traceability. Loose references (free-text ids
  /// or labels) rather than strict foreign keys, since not every linked
  /// record type is guaranteed to exist for a given evidence record.
  riskAssessmentRef        String?
  governanceReviewRef      String?
  decisionRecordRef        String?
  reauthorizationRecordRef String?
  timelineEventRef         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidenceMappings   EvidenceMapping[]
  obligationMappings ObligationEvidenceMapping[]

  @@map("evidence_records")
}

// ---------------------------------------------------------------------------
// RELEASE 5 — Universal Compliance Pack Framework
// The reusable architecture every future regulation (RBI, ISO 42001, EU AI
// Act, ...) plugs into as configuration. No regulation content here — that's
// Release 6+. No scoring: coverage is Covered/Partially Covered/Not
// Covered/Not Applicable only, computed by the frontend from these records.
// ---------------------------------------------------------------------------

enum CompliancePackStatus {
  ACTIVE
  DRAFT
  RETIRED
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequirementStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum PackControlStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// Capability 1 — Compliance Pack Registry.
model CompliancePack {
  id            String               @id
  name          String
  version       String               @default("1.0")
  status        CompliancePackStatus @default(DRAFT)
  owner         String
  description   String               @db.Text
  industry      String
  effectiveDate DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  requirements ComplianceRequirement[]

  @@map("compliance_packs")
}

/// Capability 2 — Requirement Registry. Client-supplied human-readable ids
/// (RBI-REQ-001 style) rather than generated UUIDs, since the id itself is
/// meaningful regulatory-reference content.
model ComplianceRequirement {
  id          String              @id
  name        String
  description String              @db.Text
  packId      String
  pack        CompliancePack      @relation(fields: [packId], references: [id], onDelete: Cascade)
  category    String
  priority    RequirementPriority @default(MEDIUM)
  status      RequirementStatus   @default(DRAFT)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  controls PackControl[]

  @@map("compliance_requirements")
}

/// Capability 3 — Control Registry.
model PackControl {
  id            String                @id
  name          String
  description   String                @db.Text
  requirementId String
  requirement   ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  owner         String?
  status        PackControlStatus     @default(DRAFT)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  mappings EvidenceMapping[]

  @@map("pack_controls")
}

/// Capability 4 — Evidence Mapping Framework. Requirement → Control →
/// Evidence, reusing the Release 3 EvidenceRecord so evidence is collected
/// once and applied across every pack that needs it.
model EvidenceMapping {
  id               String         @id @default(uuid())
  controlId        String
  control          PackControl    @relation(fields: [controlId], references: [id], onDelete: Cascade)
  evidenceRecordId String
  evidenceRecord   EvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([controlId, evidenceRecordId])
  @@map("evidence_mappings")
}

// ---------------------------------------------------------------------------
// RELEASE 6 — UNIVERSAL REGULATORY KNOWLEDGE & OBLIGATION ENGINE (FOUNDATION)
// Source -> Requirement -> Obligation -> Control -> Evidence. Generalizes the
// Release 5 Pack -> Requirement -> Control -> Evidence chain one layer
// deeper so a future regulation onboards as data (register a source, add
// requirements, obligations, map controls, map evidence) rather than a
// platform redesign. Neon is the System of Record from day one for this
// domain — no local-storage-first detour, per Release 6's explicit
// production principles and the Release 5.1 correction they generalize.
// ---------------------------------------------------------------------------

enum RegulatorySourceType {
  REGULATION
  STANDARD
  FRAMEWORK
  INTERNAL_POLICY
  GUIDANCE
}

enum RegulatorySourceStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}

/// Capability 1 — Regulatory Source Registry.
model RegulatorySource {
  id            String                 @id
  name          String
  sourceType    RegulatorySourceType   @default(REGULATION)
  jurisdiction  String
  industry      String
  version       String                 @default("1.0")
  effectiveDate DateTime
  reviewDate    DateTime?
  status        RegulatorySourceStatus @default(DRAFT)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  requirements RegulatoryRequirement[]

  @@map("regulatory_sources")
}

enum RequirementCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RegulatoryRequirementStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// Capability 2 — Requirement Registry. Client-supplied human-readable ids,
/// the id itself is meaningful regulatory-reference content (mirrors Release
/// 5's ComplianceRequirement).
model RegulatoryRequirement {
  id          String                      @id
  name        String
  description String                      @db.Text
  category    String
  criticality RequirementCriticality      @default(MEDIUM)
  status      RegulatoryRequirementStatus @default(DRAFT)

  sourceId String
  source   RegulatorySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  obligations Obligation[]

  @@map("regulatory_requirements")
}

enum ObligationStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// Capability 3 — Obligation Engine. Translates a requirement into actionable
/// obligations (e.g. "Human Oversight Required" -> "Named Owner", "Approval
/// Authority", "Escalation Path", "Override Capability" — each its own row).
model Obligation {
  id          String           @id
  name        String
  description String           @db.Text
  owner       String?
  status      ObligationStatus @default(DRAFT)

  requirementId String
  requirement   RegulatoryRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  controls ObligationControl[]

  @@map("obligations")
}

enum ObligationControlStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// Capability 4 — Control Mapping Engine. Maps an obligation to the OMG
/// control that satisfies it (e.g. Governance Authority Profile, Human
/// Oversight Classification, Autonomy Level, Approval Authority).
model ObligationControl {
  id          String                  @id
  name        String
  description String                  @db.Text
  owner       String?
  status      ObligationControlStatus @default(DRAFT)

  obligationId String
  obligation   Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mappings ObligationEvidenceMapping[]

  @@map("obligation_controls")
}

/// Capability 5 — Evidence Mapping Engine. Control -> Evidence, reusing the
/// Release 3 EvidenceRecord so evidence collected once is reused across
/// every requirement/obligation that needs it.
model ObligationEvidenceMapping {
  id               String            @id @default(uuid())
  controlId        String
  control          ObligationControl @relation(fields: [controlId], references: [id], onDelete: Cascade)
  evidenceRecordId String
  evidenceRecord   EvidenceRecord    @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())

  @@unique([controlId, evidenceRecordId])
  @@map("obligation_evidence_mappings")
}

// ---------------------------------------------------------------------------
// RELEASE 7 — GOVERNANCE INTELLIGENCE ENGINE (FOUNDATION)
// Governance reasoning: Policy -> Condition -> Violation -> Finding ->
// Outcome, with every outcome explainable. Detection and recommendation
// only — no automatic state changes, no automatic reassessment/escalation
// (that is Release 8). One engine only: regulation-specific intelligence
// (RBI/ISO/EU AI Act) stays out of scope, same "foundation, not regulation"
// discipline as Releases 5 and 6. Named GovernancePolicy/GovernanceFinding
// (not Policy/Finding) to avoid colliding with the existing Phase 3 Finding
// and Phase 9 Policy models, which are different, unrelated concepts.
// Neon is the System of Record from day one, per the blueprint's mandatory
// production principles — same discipline Release 6 established.
// ---------------------------------------------------------------------------

enum GovernancePolicySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GovernancePolicyStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// The condition types the Condition Engine detects (Objective 2) and a
/// GovernancePolicy's triggerCondition watches for (Objective 3). Detection
/// only — computed on read from existing governance data, not a table.
enum GovernanceConditionType {
  EVIDENCE_EXPIRED
  REVIEW_OVERDUE
  MISSING_APPROVAL
  MISSING_OWNER
  MISSING_VALIDATION
  MISSING_REAUTHORIZATION
}

/// Objective 1 — Policy Registry. "Linked Obligation" and "Linked Controls"
/// are loose references (ids only, not enforced foreign keys) since a policy
/// may reference either Release 5's PackControl or Release 6's
/// ObligationControl — the same loose-reference pattern EvidenceRecord's
/// traceability fields already use for exactly this reason.
model GovernancePolicy {
  id               String                   @id
  name             String
  description      String                   @db.Text
  category         String
  severity         GovernancePolicySeverity @default(MEDIUM)
  status           GovernancePolicyStatus   @default(DRAFT)
  triggerCondition GovernanceConditionType
  obligationId     String?
  linkedControlIds String[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  findings           GovernanceFinding[]
  recommendedActions RecommendedAction[]

  @@map("governance_policies")
}

enum GovernanceFindingStatus {
  OPEN
  UNDER_REVIEW
  ACCEPTED_RISK
  RESOLVED
}

/// Objective 4 — Findings Engine. Unlike Conditions (detected live) and
/// Outcomes (recommended live), a Finding is a persisted, owned record with
/// a manually-managed lifecycle — someone accepts risk or resolves it — so
/// it is Neon-backed like every other governance record in OMG, not
/// recomputed on every read.
model GovernanceFinding {
  id              String                   @id @default(uuid())
  assetId         String
  asset           AIAsset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  policyId        String
  policy          GovernancePolicy         @relation(fields: [policyId], references: [id], onDelete: Cascade)
  conditionType   GovernanceConditionType
  severity        GovernancePolicySeverity
  status          GovernanceFindingStatus  @default(OPEN)
  detail          String                   @db.Text
  createdDate     DateTime                 @default(now())
  resolutionDate  DateTime?
  resolutionNotes String?                  @db.Text
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  recommendedActions RecommendedAction[]

  @@map("governance_findings")
}

// ---------------------------------------------------------------------------
// RELEASE 8 — GOVERNANCE INTELLIGENCE ENGINE (ACTIONS EDITION)
// The bridge between Governance Intelligence and Governance Execution:
// ...Outcome -> Recommended Action, with a human Accept/Reject/Defer layer.
// Recommendation-driven, not automation-driven — nothing here executes
// automatically or changes an asset's governance state. Action templates
// (Condition -> tactical action) and the Outcome -> procedural action
// mapping, plus the three Governance Playbooks, are static reference config
// (frontend/src/config/governanceActionsEngine.ts), not database rows —
// they're reusable logic, not tenant data, the same reasoning that keeps
// Conditions/Violations/Outcomes computed rather than stored in Release 7.
// ---------------------------------------------------------------------------

enum RecommendedActionType {
  REVIEW
  REASSESSMENT
  VALIDATION
  APPROVAL
  REAUTHORIZATION
  OWNERSHIP
  ESCALATION
}

enum RecommendedActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendedActionStatus {
  OPEN
  ACCEPTED
  DEFERRED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

/// Objective 1 — Recommended Action Engine. Related Policy and Related
/// Finding are optional: an action generated from an Outcome (Objective 3)
/// may not trace to one specific finding, only to the asset's overall
/// recommendation.
model RecommendedAction {
  id          String                @id @default(uuid())
  actionType  RecommendedActionType
  name        String
  description String                @db.Text

  assetId String
  asset   AIAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  policyId String?
  policy   GovernancePolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  findingId String?
  finding   GovernanceFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  priority RecommendedActionPriority @default(MEDIUM)
  owner    String?
  dueDate  DateTime?
  status   RecommendedActionStatus   @default(OPEN)

  /// Release 9 — Objective 6's Human Decision Layer, made traceable. Set only
  /// when a human actually decides (Accept / Reject / Defer), not on the
  /// Start / Complete execution-tracking transitions — this is "who acted",
  /// not "who last touched the row".
  decidedBy String?
  decidedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recommended_actions")
}

// ---------------------------------------------------------------------------
// RELEASE 10 — GOVERNANCE INTELLIGENCE STUDIO (CUSTOMER CONFIGURATION EDITION)
// Converts the parts of the Release 7/8 reasoning engine that were hardcoded
// TypeScript config into genuinely editable Neon-backed rules — "configure
// governance logic without code changes." The Condition -> Policy link
// already existed as data since Release 7 (GovernancePolicy.triggerCondition)
// and needs no new table; this release covers the two links that were still
// code (Policy -> Outcome, Outcome -> Action) plus the Condition and
// Customer Governance Profile catalogues. Detection *mechanisms* and outcome
// *evaluation order* remain platform primitives (same "foundation, not a
// rules DSL" discipline as every prior release) — what's configurable is
// which of them are enabled, and what they're labelled/produce.
// ---------------------------------------------------------------------------

/// Objective 3 — Condition Designer. One row per GovernanceConditionType;
/// enabled=false makes detectGovernanceConditions() skip that condition type
/// entirely for every asset, without touching code.
model ConditionDefinition {
  id              String                   @id
  conditionType   GovernanceConditionType  @unique
  label           String
  description     String                   @db.Text
  defaultSeverity GovernancePolicySeverity @default(MEDIUM)
  enabled         Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@map("condition_definitions")
}

enum GovernanceOutcomeStatus {
  COMPLIANT
  ATTENTION_REQUIRED
  REVIEW_REQUIRED
  REASSESSMENT_RECOMMENDED
  ESCALATION_RECOMMENDED
}

/// Objective 4 — Outcome Designer. One row per outcome tier in the fixed
/// escalation ladder; enabled=false makes computeGovernanceOutcome() skip
/// that tier's check and fall through to the next enabled one. The ladder's
/// severity *order* is a platform primitive (Escalation outranks Review,
/// always); only which tiers are active is configurable.
model OutcomeRule {
  id            String                  @id
  outcomeStatus GovernanceOutcomeStatus @unique
  description   String                  @db.Text
  enabled       Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@map("outcome_rules")
}

enum ActionRuleTriggerType {
  CONDITION
  OUTCOME
}

/// Objectives 5 & 6 — Action Designer and the Outcome -> Action / Condition
/// -> Action legs of the Rule Mapping Engine. Replaces the hardcoded
/// CONDITION_ACTION_TEMPLATES / OUTCOME_ACTION_TEMPLATES maps from Release 8
/// with editable rows — the Action Recommendation Library made configurable.
model ActionRule {
  id                String                @id @default(uuid())
  triggerType       ActionRuleTriggerType
  /// A GovernanceConditionType or GovernanceOutcomeStatus, stored as its
  /// string value — loose reference, same pattern EvidenceRecord's
  /// traceability fields and GovernancePolicy.obligationId already use.
  triggerValue      String
  actionType        RecommendedActionType
  actionName        String
  actionDescription String                @db.Text
  enabled           Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([triggerType, triggerValue])
  @@map("action_rules")
}

/// Objective 8 — Customer Governance Profiles. Named presets (Banking,
/// Insurance, Healthcare, Government, Enterprise); exactly one is active at
/// a time, representing which industry configuration the tenant is running.
model GovernanceProfile {
  id          String   @id
  name        String
  industry    String
  description String   @db.Text
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("governance_profiles")
}

model AuditLog {
  id         String   @id @default(uuid())
  timestamp  DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  userName   String
  userRole   String
  action     String
  entityType String
  entityId   String
  entityName String
  details    String   @db.Text
  ipAddress  String?

  assetId String?
  asset   AIAsset? @relation(fields: [assetId], references: [id])

  @@map("audit_logs")
}
